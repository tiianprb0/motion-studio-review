[
  {
    "position": "top-left",
    "width": 540,
    "text": "Memahami perasaan\nseseorang"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "bukan berarti kamu harus"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "menoleransi perilakunya\nselamanya."
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "Pernah lihat\ncerita tentang"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "seorang perempuan\nyang mendapati"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "pasangannya memeriksa HP-nya saat"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "dia tidur?"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "Alih-alih marah,\ndia justru"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "mencoba memahami apa yang membuat"
  },
  {
    "position": "bottom-right",
    "width": 540,
    "text": "pasangannya merasa\ntidak aman."
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "Bahkan, dia\nmemberikan keyakinan"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "bahwa hanya ada dia\ndi hatinya."
  },
  {
    "position": "bottom-left",
    "width": 540,
    "text": "Dan jujur,"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "tidak ada yang salah dengan itu."
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "Setidaknya, untuk\npertama atau"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "kedua kalinya,\nmemahami perasaan"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "seseorang bisa menjadi bentuk empati."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "Tetapi, bagaimana jika hal yang sama terus berulang?"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "Di sinilah kita perlu\nmembedakan"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "antara memahami\nperasaan dan"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "membiarkan perilaku."
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "Ketika sesuatu terus\nterjadi, kita"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "tidak lagi hanya\nmembicarakan"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "sebuah kesalahan."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "Kita mulai melihat sebuah pola."
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "Pola butuh lebih\ndari pengertian."
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "Perlu tanggung jawab."
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "Pertama kali,\npahami perasaannya."
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "Saat terulang,\nsampaikan batasanmu."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "Saat menjadi kebiasaan, harapkan tanggung jawab dan perubahan."
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "Empati membantu\nseseorang tumbuh,"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "bukan memberinya izin mengulangi kesalahan yang sama."
  }
]