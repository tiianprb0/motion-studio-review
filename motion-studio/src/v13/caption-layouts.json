[
  {
    "position": "top-left",
    "width": 720,
    "text": "Memahami perasaan seseorang"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "bukan berarti kamu harus"
  },
  {
    "position": "top-right",
    "width": 720,
    "text": "menoleransi perilakunya selamanya."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Pernah lihat cerita tentang"
  },
  {
    "position": "top-right",
    "width": 720,
    "text": "seorang perempuan yang mendapati"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "pasangannya memeriksa HP-nya saat"
  },
  {
    "position": "bottom-left",
    "width": 340,
    "text": "dia tidur?"
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Alih-alih marah, dia justru"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "mencoba memahami apa yang membuat"
  },
  {
    "position": "bottom-right",
    "width": 340,
    "text": "pasangannya merasa tidak aman."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Bahkan, dia memberikan keyakinan"
  },
  {
    "position": "top-right",
    "width": 720,
    "text": "bahwa hanya ada dia di hatinya."
  },
  {
    "position": "bottom-left",
    "width": 340,
    "text": "Dan jujur,"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "tidak ada yang salah dengan itu."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Setidaknya, untuk pertama atau"
  },
  {
    "position": "top-right",
    "width": 720,
    "text": "kedua kalinya, memahami perasaan"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "seseorang bisa menjadi bentuk empati."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "Tetapi, bagaimana jika hal yang sama terus berulang?"
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Di sinilah kita perlu membedakan"
  },
  {
    "position": "bottom-left",
    "width": 340,
    "text": "antara memahami perasaan dan"
  },
  {
    "position": "top-right",
    "width": 720,
    "text": "membiarkan perilaku."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Ketika sesuatu terus terjadi, kita"
  },
  {
    "position": "top-right",
    "width": 720,
    "text": "tidak lagi hanya membicarakan"
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "sebuah kesalahan."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "Kita mulai melihat sebuah pola."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Dan pola membutuhkan lebih dari sekadar pengertian."
  },
  {
    "position": "top-right",
    "width": 720,
    "text": "Perlu tanggung jawab."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Saat pertama kali, pahami perasaannya."
  },
  {
    "position": "top-right",
    "width": 720,
    "text": "Saat terulang, sampaikan batasanmu."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "Saat menjadi kebiasaan, harapkan tanggung jawab dan perubahan."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Karena empati seharusnya membantu seseorang tumbuh,"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "bukan memberinya izin mengulangi kesalahan yang sama."
  }
]