  "segments": [
    {
      "id": "beat1",
      "text": "katanya, buat apa ikut demonstrasi kalau masih bisa membeli minuman mahal?",
      "start": 0,
      "end": 5.62
    },
    {
      "id": "beat2",
      "text": "aku justru ingin bertanya, sejak kapan kemampuan seseorang membeli sesuatu menentukan apakah dia berhak menyuarakan ketidakadilan?",
      "start": 5.62,
      "end": 14.4
    },
    {
      "id": "beat3",
      "text": "aku mungkin masih punya pekerjaan, masih bisa membeli makanan yang layak, bahkan menikmati sesuatu yang tidak semua orang mampu beli.",
      "start": 14.4,
      "end": 22.419999999999998
    },
    {
      "id": "beat4",
      "text": "tapi apakah itu berarti aku harus menutup mata terhadap mereka yang bahkan kesulitan memenuhi kebutuhan sehari-hari?",
      "start": 22.419999999999998,
      "end": 30.8
    },
    {
      "id": "beat5",
      "text": "aku sadar, tidak semua orang punya kesempatan untuk bersuara.",
      "start": 30.8,
      "end": 35.339999999999996
    },
    {
      "id": "beat6",
      "text": "ada orang yang harus memilih antara ikut menyampaikan aspirasi atau kehilangan penghasilan hari itu.",
      "start": 35.339999999999996,
      "end": 41.94
    },
    {
      "id": "beat7",
      "text": "ada yang terlalu sibuk bertahan hidup, sampai tidak punya waktu, tenaga, bahkan keberanian untuk memperjuangkan haknya sendiri.",
      "start": 41.94,
      "end": 50.12
    },
    {
      "id": "beat8",
      "text": "itulah mengapa aku percaya, tidak semua orang turun ke jalan hanya untuk dirinya sendiri.",
      "start": 50.12,
      "end": 56.879999999999995
    },
    {
      "id": "beat9",
      "text": "terkadang, aku memperjuangkan sesuatu yang mungkin tidak pernah bisa diperjuangkan oleh orang yang paling membutuhkan perubahan itu.",
      "start": 56.879999999999995,
      "end": 65.22
    },
    {
      "id": "beat10",
      "text": "karena kepedulian tidak harus lahir dari penderitaan yang sama.",
      "start": 65.22,
      "end": 69.10000000000001
    },
    {
      "id": "beat11",
      "text": "LESS CERTAIN.",
      "start": 69.10000000000001,
      "end": 71.29
    }
  ],
