  "segments": [
    {
      "id": "hook",
      "art": "hook",
      "kicker": "CATATAN TENTANG EMPATI",
      "title": [
        "Memahami.",
        "Bukan berarti",
        "membiarkan."
      ],
      "text": "Understanding someone’s feelings doesn’t mean you have to tolerate their behavior forever.",
      "start": 0,
      "end": 5.395351032448378
    },
    {
      "id": "phone",
      "art": "bed",
      "kicker": "SEBUAH CERITA",
      "title": [
        "Saat kepercayaan",
        "mulai diuji."
      ],
      "text": "Pernah lihat cerita tentang seorang perempuan yang mendapati pasangannya memeriksa HP-nya saat dia tidur?",
      "start": 5.395351032448378,
      "end": 11.955351032448378
    },
    {
      "id": "insecurity",
      "art": "empathy",
      "kicker": "DI BALIK PERILAKU",
      "title": [
        "Ada rasa",
        "tidak aman."
      ],
      "text": "Alih-alih marah, dia justru mencoba memahami apa yang membuat pasangannya merasa tidak aman.",
      "start": 11.955351032448378,
      "end": 18.33535103244838
    },
    {
      "id": "reassurance",
      "art": "reassure",
      "kicker": "MENCOBA MENGERTI",
      "title": [
        "Menenangkan.",
        "Meyakinkan."
      ],
      "text": "Bahkan, dia memberikan reassurance bahwa hanya ada dia di hatinya. And honestly, there’s nothing wrong with that.",
      "start": 18.33535103244838,
      "end": 26.59535103244838
    },
    {
      "id": "empathy",
      "art": "heart",
      "kicker": "PERTAMA ATAU KEDUA KALI",
      "title": [
        "Itu bisa menjadi",
        "bentuk empati."
      ],
      "text": "Setidaknya, untuk pertama atau kedua kalinya, memahami perasaan seseorang bisa menjadi bentuk empati.",
      "start": 26.59535103244838,
      "end": 34.05535103244838
    },
    {
      "id": "repeat",
      "art": "repeat",
      "kicker": "TAPI, BAGAIMANA JIKA…",
      "title": [
        "Terjadi.",
        "Lagi. Dan lagi."
      ],
      "text": "Tetapi, bagaimana jika hal yang sama terus berulang?",
      "start": 34.05535103244838,
      "end": 38.515351032448365
    },
    {
      "id": "distinction",
      "art": "split",
      "kicker": "BEDAKAN DUA HAL INI",
      "title": [
        "Memahami rasa.",
        "Membatasi tindakan."
      ],
      "text": "Di sinilah kita perlu membedakan antara memahami perasaan dan membiarkan perilaku.",
      "start": 38.515351032448365,
      "end": 44.81535103244837
    },
    {
      "id": "mistake",
      "art": "pattern",
      "kicker": "BUKAN HANYA SATU KEJADIAN",
      "title": [
        "Sebuah kesalahan…"
      ],
      "text": "Ketika sesuatu terus terjadi, kita tidak lagi hanya membicarakan sebuah kesalahan.",
      "start": 44.81535103244837,
      "end": 50.45535103244837
    },
    {
      "id": "pattern",
      "art": "pattern",
      "kicker": "LIHAT YANG BERULANG",
      "title": [
        "…menjadi",
        "sebuah pola."
      ],
      "text": "Kita mulai melihat sebuah pola.",
      "start": 50.45535103244837,
      "end": 53.035351032448375
    },
    {
      "id": "accountability",
      "art": "action",
      "kicker": "PENGERTIAN SAJA TIDAK CUKUP",
      "title": [
        "Perlu tanggung",
        "jawab."
      ],
      "text": "Dan pola membutuhkan lebih dari sekadar pengertian. It requires accountability.",
      "start": 53.035351032448375,
      "end": 59.255351032448374
    },
    {
      "id": "step1",
      "art": "steps",
      "step": 0,
      "kicker": "01 / PAHAMI",
      "title": [
        "Understand",
        "the feeling."
      ],
      "text": "First time, understand the feeling.",
      "start": 59.255351032448374,
      "end": 62.05535103244837
    },
    {
      "id": "step2",
      "art": "steps",
      "step": 1,
      "kicker": "02 / KOMUNIKASIKAN",
      "title": [
        "Communicate",
        "your boundaries."
      ],
      "text": "When it repeats, communicate your boundaries.",
      "start": 62.05535103244837,
      "end": 65.21535103244837
    },
    {
      "id": "step3",
      "art": "steps",
      "step": 2,
      "kicker": "03 / HARAPKAN PERUBAHAN",
      "title": [
        "Accountability.",
        "And change."
      ],
      "text": "And when it becomes a habit, expect accountability and change.",
      "start": 65.21535103244837,
      "end": 69.73535103244836
    },
    {
      "id": "closing",
      "art": "grow",
      "kicker": "EMPATI YANG SEHAT",
      "title": [
        "Membantu tumbuh.",
        "Bukan mengulang."
      ],
      "text": "Because empathy should help someone grow, not give them permission to repeat the same mistake.",
      "start": 69.73535103244836,
      "end": 76.3666666667
    }
  ],
