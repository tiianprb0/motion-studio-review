[
  {
    "position": "top-left",
    "width": 720,
    "text": "Pacarku punya\nsatu kebiasaan"
  },
  {
    "position": "bottom-left",
    "width": 300,
    "text": "yang selalu\nmembuatku\nkesal."
  },
  {
    "position": "top-right",
    "width": 650,
    "text": "Setiap kali\nkami bertengkar,"
  },
  {
    "position": "top-right",
    "width": 600,
    "text": "dia nggak pernah\nbilang maaf."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "Tapi besoknya, dia\ntiba-tiba bertanya"
  },
  {
    "position": "top-right",
    "width": 620,
    "text": "apakah aku\nsudah makan,"
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "membelikan makanan\nkesukaanku,"
  },
  {
    "position": "top-right",
    "width": 640,
    "text": "atau melakukan hal-hal\nkecil untukku."
  },
  {
    "position": "bottom-right",
    "width": 300,
    "text": "Awalnya\naku pikir"
  },
  {
    "position": "top-left",
    "width": 600,
    "text": "dia cuma\ngengsi."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "Sampai aku tahu,\ndi rumahnya dulu,"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "nggak ada yang terbiasa\nmeminta maaf."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Setelah bapaknya\nmarah besar,"
  },
  {
    "position": "middle-left",
    "width": 290,
    "text": "besoknya\nmungkin\nsudah ada"
  },
  {
    "position": "bottom-center",
    "width": 720,
    "text": "martabak di meja."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Buat keluarganya,\nitulah cara"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "mereka kembali\nberdamai."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Akhirnya aku\nmengerti,"
  },
  {
    "position": "bottom-center",
    "width": 720,
    "text": "mungkin dia bukan\nnggak mau meminta maaf."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Dia hanya mengenal\ncara berbeda\nuntuk menunjukkannya."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "Jadi, suatu hari ketika\ndia kembali"
  },
  {
    "position": "bottom-center",
    "width": 720,
    "text": "melakukan hal kecil\nuntukku"
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "setelah bertengkar,\naku bilang,"
  },
  {
    "position": "bottom-left",
    "width": 300,
    "text": "“Makasih\nya."
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "Aku tahu ini caramu\nminta maaf.”"
  },
  {
    "position": "bottom-right",
    "width": 300,
    "text": "Dan mungkin,\ndari situ"
  },
  {
    "position": "top-left",
    "width": 720,
    "text": "dia mulai belajar\nbahwa kata maaf"
  },
  {
    "position": "bottom-left",
    "width": 300,
    "text": "juga boleh\ndiucapkan."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "Terkadang, memahami\nlatar belakang seseorang"
  },
  {
    "position": "top-right",
    "width": 720,
    "text": "adalah langkah pertama"
  },
  {
    "position": "bottom-center",
    "width": 720,
    "text": "untuk membantunya\nbertumbuh."
  }
]