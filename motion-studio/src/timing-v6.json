  {
   "id": "hook1",
   "title": [
    "Pernah nggak,",
    "kamu bertengkar",
    "dengan pasanganmu?"
   ],
   "text": "Pernah nggak, kamu bertengkar dengan pasanganmu.",
   "start": 0.0,
   "end": 3.44
  },
  {
   "id": "hook2",
   "title": [
    "Besoknya,",
    "tidak ada maaf."
   ],
   "text": "Besoknya, dia nggak bilang maaf. Bahkan nggak membahas pertengkaran kalian semalam.",
   "start": 3.44,
   "end": 9.360000000000001
  },
  {
   "id": "hook3",
   "title": [
    "Tiba-tiba:",
    "makanan favoritmu."
   ],
   "text": "Tapi tiba-tiba, dia membelikan makanan kesukaanmu. Atau mungkin, dia mengerjakan sesuatu yang biasanya kamu lakukan. Seolah-olah tidak terjadi apa-apa.",
   "start": 9.360000000000001,
   "end": 20.9
  },
  {
   "id": "dev1",
   "title": [
    "Mungkin kamu pikir:",
    "dia gengsi."
   ],
   "text": "Awalnya, mungkin kamu berpikir dia terlalu gengsi untuk meminta maaf.",
   "start": 20.9,
   "end": 26.14
  },
  {
   "id": "dev2",
   "title": [
    "Tapi pernah",
    "kamu pikirkan?"
   ],
   "text": "Tapi pernahkah kamu berpikir, mungkin dia memang nggak terbiasa mengucapkan kata itu?",
   "start": 26.14,
   "end": 32.459999999999994
  },
  {
   "id": "dev3",
   "title": [
    "Sejak kecil,",
    "tidak ada maaf."
   ],
   "text": "Mungkin sejak kecil, setiap kali ada pertengkaran di rumahnya, nggak ada yang saling meminta maaf. Semuanya hanya kembali seperti biasa.",
   "start": 32.459999999999994,
   "end": 41.839999999999996
  },
  {
   "id": "dev4",
   "title": [
    "Marah hari ini.",
    "Sarapan besok."
   ],
   "text": "Seseorang marah hari ini, lalu besok sudah menyiapkan sarapan seperti tidak terjadi apa-apa.",
   "start": 41.839999999999996,
   "end": 48.459999999999994
  },
  {
   "id": "dev5",
   "title": [
    "Perhatian,",
    "bukan kata."
   ],
   "text": "Tanpa disadari, dia belajar bahwa perhatian adalah cara untuk memperbaiki hubungan.",
   "start": 48.459999999999994,
   "end": 54.98
  },
  {
   "id": "shift1",
   "title": [
    "Bukan berarti",
    "caranya benar."
   ],
   "text": "Bukan berarti caranya selalu benar.",
   "start": 54.98,
   "end": 56.99999999999999
  },
  {
   "id": "shift2",
   "title": [
    "Kamu tetap berhak",
    "mendengar maaf."
   ],
   "text": "Karena kamu tetap berhak mendengar kata maaf ketika seseorang menyakitimu.",
   "start": 56.99999999999999,
   "end": 62.48
  },
  {
   "id": "shift3",
   "title": [
    "Melihat dengan",
    "cara berbeda."
   ],
   "text": "Tapi memahami latar belakangnya mungkin membuatmu melihat perilakunya dengan cara berbeda.",
   "start": 62.48,
   "end": 69.10000000000001
  },
  {
   "id": "close1",
   "title": [],
   "text": "Sometimes, people don’t know how to express what they’ve never been taught.",
   "start": 69.10000000000001,
   "end": 73.02
  },
  {
   "id": "close2",
   "title": [
    "Memahami",
    "bukan menerima."
   ],
   "text": "And understanding that doesn’t mean you have to accept everything.",
   "start": 73.02,
   "end": 77.68333333333334
  }
 ],
