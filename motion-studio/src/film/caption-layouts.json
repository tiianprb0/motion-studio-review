[
  {
    "position": "top-left",
    "width": 540,
    "text": "katanya, buat apa"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "ikut demonstrasi\nkalau masih"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "bisa membeli\nminuman mahal?"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "aku justru ingin\nbertanya, sejak"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "kapan kemampuan\nseseorang membeli"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "sesuatu menentukan\napakah dia"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "berhak menyuarakan\nketidakadilan?"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "aku mungkin masih\npunya pekerjaan,"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "masih bisa membeli\nmakanan yang layak,"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "bahkan menikmati\nsesuatu"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "yang tidak semua\norang mampu beli."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "tapi apakah itu berarti"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "aku harus menutup\nmata terhadap"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "mereka yang\nbahkan kesulitan"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "memenuhi kebutuhan\nsehari-hari?"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "aku sadar, tidak\nsemua orang"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "punya kesempatan\nuntuk bersuara."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "ada orang yang\nharus memilih"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "antara ikut\nmenyampaikan aspirasi"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "atau kehilangan\npenghasilan hari itu."
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "ada yang terlalu\nsibuk bertahan"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "hidup, sampai\ntidak punya waktu,"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "tenaga, bahkan\nkeberanian"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "untuk memperjuangkan\nhaknya sendiri."
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "itulah mengapa\naku percaya,"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "tidak semua orang\nturun ke jalan"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "hanya untuk\ndirinya sendiri."
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "terkadang, aku\nmemperjuangkan"
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "sesuatu yang mungkin\ntidak pernah bisa"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "diperjuangkan oleh\norang yang paling"
  },
  {
    "position": "top-left",
    "width": 540,
    "text": "membutuhkan\nperubahan itu."
  },
  {
    "position": "top-right",
    "width": 540,
    "text": "karena kepedulian\ntidak harus lahir"
  },
  {
    "position": "top-center",
    "width": 720,
    "text": "dari penderitaan\nyang sama."
  }
]