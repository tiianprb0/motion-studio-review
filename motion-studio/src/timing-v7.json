  "segments": [
    {
      "id": "habit",
      "title": "Satu kebiasaan.",
      "text": "pacarku punya satu kebiasaan yang selalu membuatku kesal.",
      "start": 0,
      "end": 4.6
    },
    {
      "id": "silence",
      "title": "Setelah bertengkar.",
      "text": "setiap kali kami bertengkar, dia nggak pernah bilang maaf.",
      "start": 4.6,
      "end": 8.540000000000001
    },
    {
      "id": "care",
      "title": "Sudah makan?",
      "text": "tapi besoknya, dia tiba-tiba bertanya apakah aku sudah makan, membelikan makanan kesukaanku, atau melakukan hal-hal kecil untukku.",
      "start": 8.540000000000001,
      "end": 17.88
    },
    {
      "id": "pride",
      "title": "Kupikir, gengsi.",
      "text": "awalnya aku pikir dia cuma gengsi.",
      "start": 17.88,
      "end": 21.1
    },
    {
      "id": "home",
      "title": "Di rumahnya dulu.",
      "text": "sampai aku tahu, di rumahnya dulu, nggak ada yang terbiasa meminta maaf.",
      "start": 21.1,
      "end": 26.8
    },
    {
      "id": "martabak",
      "title": "Marah. Lalu martabak.",
      "text": "setelah bapaknya marah besar, besoknya mungkin sudah ada martabak di meja.",
      "start": 26.8,
      "end": 32.02
    },
    {
      "id": "peace",
      "title": "Begitulah mereka berdamai.",
      "text": "buat keluarganya, itulah cara mereka kembali berdamai.",
      "start": 32.02,
      "end": 36.04
    },
    {
      "id": "understand",
      "title": "Aku mulai mengerti.",
      "text": "akhirnya aku mengerti, mungkin dia bukan nggak mau meminta maaf. dia hanya mengenal cara yang berbeda untuk menunjukkannya.",
      "start": 36.04,
      "end": 45.12
    },
    {
      "id": "again",
      "title": "Kali ini, aku bicara.",
      "text": "jadi, suatu hari ketika dia kembali melakukan hal kecil untukku setelah bertengkar, aku bilang,",
      "start": 45.12,
      "end": 52.1
    },
    {
      "id": "thanks",
      "title": "Aku tahu.",
      "text": "“makasih ya. aku tahu ini caramu minta maaf.”",
      "start": 52.1,
      "end": 55.5
    },
    {
      "id": "learn",
      "title": "Kata-kata juga boleh.",
      "text": "dan mungkin, dari situ dia mulai belajar bahwa kata maaf juga boleh diucapkan.",
      "start": 55.5,
      "end": 62.92
    },
    {
      "id": "growth",
      "title": "Ruang untuk tumbuh.",
      "text": "sometimes, understanding where someone comes from is the first step to helping them grow.",
      "start": 62.92,
      "end": 69.03999999999999
    },
    {
      "id": "brand",
      "title": "less.certain",
      "text": "LESS CERTAIN.",
      "start": 69.03999999999999,
      "end": 70.75999999999999
    }
